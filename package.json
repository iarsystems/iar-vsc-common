{
  "name": "iar-vsc-common",
  "version": "1.0.0",
  "description": "Common code for all IAR VS Code extensions",
  "exports": {
    "./*": "./dist/*.js",
    "./thrift/*": "./dist/thrift/*.js",
    "./thrift/bindings/*": "./dist/thrift/bindings/*.js"
  },
  "files": [
    "dist",
    "src"
  ]
  "typesVersions": {
    "*": {
      "thrift/bindings/*": [
        "dist/thrift/bindings/*.d.ts"
      ],
      "thrift/*": [
        "dist/thrift/*.d.ts"
      ],
      "*": [
        "dist/*.d.ts"
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "watch": "tsc -p . --watch",
    "prepare": "husky install && tsc -p . && cp -r \"src/thrift/bindings\" dist/thrift/"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.iar.se/ide/vscode/iar-vsc-common"
  },
  "author": "iarsystems",
  "license": "MPL-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^18.0.0",
    "@types/thrift": "^0.10.9",
    "@types/uuid": "^8.3.1",
    "@types/vscode": "^1.33.0",
    "eslint": "^10.0.0",
    "globals": "^15.0.0",
    "husky": "^8.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "thrift": "^0.12.0",
    "uuid": "^8.3.2"
  }
}
